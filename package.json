{
  "name": "bass-hub",
  "productName": "Bass Hub",
  "version": "1.0.0",
  "description": "A premium local-first organizer for serious anglers.",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "build:ios": "vite build -c vite.ios.config.mjs && cap sync ios",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "lint": "echo \"No linting configured\"",
    "assets:ios": "swiftc -O scripts/ios-assets.swift -o /tmp/ios-assets && /tmp/ios-assets"
  },
  "keywords": [],
  "author": {
    "name": "Rich Fredericks",
    "email": "richfredericks@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "39.2.7",
    "typescript": "7.0.2",
    "vite": "^5.4.21",
    "vite-plugin-static-copy": "^3.1.4"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@vis.gl/react-google-maps": "^1.7.1",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.5.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  }
}
